{
  "$schema": "https://v2-9-15.turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": [
        "DATABASE_URL",
        "REDIS_URL",
        "UPSTASH_REDIS_REST_URL",
        "UPSTASH_REDIS_REST_TOKEN"
      ],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "passThroughEnv": [
        "BETTER_AUTH_SECRET",
        "BETTER_AUTH_URL",
        "NODE_OPTIONS",
        "NEXT_TELEMETRY_DISABLED"
      ]
    },
    "lint": {},
    "check-types": {},
    "test": {
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*",
        "vitest.config.ts",
        "vitest.config.*.ts",
        "**/__tests__/**",
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/*.spec.ts",
        "**/*.spec.tsx"
      ],
      "outputs": [],
      "passThroughEnv": ["VITEST_MAX_WORKERS"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "https": {
      "cache": false,
      "persistent": true
    },
    "packages:dev": {
      "cache": false,
      "persistent": true
    },
    "db:migrate": {
      "cache": false,
      "persistent": true
    },
    "db:setup": {
      "cache": false
    },
    "db:reset": {
      "cache": false
    },
    "db:studio": {
      "cache": false
    }
  }
}
